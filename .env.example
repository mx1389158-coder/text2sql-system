TEXT2SQL_ENV=development
# production 必须至少配置单 Key 或多 Key JSON 之一，否则 API 拒绝启动。
TEXT2SQL_API_KEY=
# 多用户部署时使用；每个 scope 必须在 access_policy.json 中显式存在，否则 deny-all。
# 例如 {"analyst-key":"restricted_analyst","admin-key":"default"}
TEXT2SQL_API_KEYS_JSON=
TEXT2SQL_DATABASE_URL=sqlite:///./data/snapshots/demo.db
TEXT2SQL_DATABASE_SCHEMA=main
TEXT2SQL_CATALOG_PATH=./data/processed/catalog_v1.json
TEXT2SQL_SEMANTIC_CATALOG_PATH=./data/processed/semantic_catalog_v1.json
TEXT2SQL_LLM_PROVIDER=demo
TEXT2SQL_LLM_BASE_URL=http://localhost:11434/v1
TEXT2SQL_LLM_API_KEY=ollama
TEXT2SQL_LLM_MODEL=qwen2.5-coder:3b
TEXT2SQL_MODEL_TIMEOUT_SECONDS=60
TEXT2SQL_MODEL_MAX_TOKENS=256
TEXT2SQL_STATEMENT_TIMEOUT_MS=5000
TEXT2SQL_LOCK_TIMEOUT_MS=1000
TEXT2SQL_MAX_ROWS=200
TEXT2SQL_SCHEMA_TOP_K=6
TEXT2SQL_SCHEMA_MAX_TOP_K=12
TEXT2SQL_SCHEMA_DENSE_WEIGHT=0.35
TEXT2SQL_SCHEMA_TOKEN_BUDGET=3000
TEXT2SQL_MAX_REPAIR_ROUNDS=2
TEXT2SQL_CANDIDATE_COUNT=3
TEXT2SQL_CACHE_TTL_SECONDS=300
TEXT2SQL_SCHEMA_CACHE_TTL_SECONDS=3600
TEXT2SQL_FEW_SHOT_PATH=./training/datasets/raw/train.jsonl
TEXT2SQL_FEW_SHOT_COUNT=3
TEXT2SQL_ENABLE_FEW_SHOTS=true
TEXT2SQL_ENABLE_FK_COMPLETION=true
TEXT2SQL_ENABLE_ADAPTIVE_SCHEMA=true
TEXT2SQL_STATE_DATABASE_PATH=./data/state/text2sql-state.db
TEXT2SQL_ACCESS_POLICY_PATH=./data/security/access_policy.json
TEXT2SQL_RATE_LIMIT_REQUESTS=60
TEXT2SQL_RATE_LIMIT_WINDOW_SECONDS=60
TEXT2SQL_MAX_CONCURRENT_REQUESTS=8
TEXT2SQL_EVALUATION_CONCURRENCY=1
TEXT2SQL_EVALUATION_ALLOWED_ROOT=./data
TEXT2SQL_MODEL_PARSE_RETRIES=1
# Langfuse Cloud/self-hosted credentials (official SDK variable names).
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TEXT2SQL_POSTGRES_PORT=15432
TEXT2SQL_REDIS_PORT=16379
TEXT2SQL_API_PORT=18000
TEXT2SQL_WEB_PORT=15173

